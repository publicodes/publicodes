{
	"name": "publicodes-monorepo",
	"version": "",
	"private": true,
	"type": "module",
	"scripts": {
		"test": "turbo run test",
		"prepack": "\"$npm_execpath\" run build",
		"test:type": "turbo run test:type",
		"build": "turbo run build",
		"build:compiler": "turbo run build:compiler",
		"test:compiler": "turbo run test:compiler",
		"build:packages": "turbo run build --filter=\\{./packages/*\\}",
		"build:autodoc-example": "make -C examples/models models && make -C examples/autodoc-playground models",
		"eslint": "eslint --cache --flag v10_config_lookup_from_file",
		"lint": "prettier --check . && \"$npm_execpath\" run build:packages && \"$npm_execpath\" run eslint . --quiet && turbo run lint --parallel",
		"format": "\"$npm_execpath\" run build:packages && \"$npm_execpath\" run eslint --fix . && prettier --write . && turbo run format --parallel",
		"dev": "turbo run dev --filter=\"website...\"",
		"clean": "turbo run clean --parallel && rimraf \"**/node_modules\" \"**/dist\" \"**/*.codegen.*\" \"**/.turbo\"",
		"release": "\"$npm_execpath\" run prepack && changeset publish",
		"version": "./.changeset/version.sh"
	},
	"dependencies": {
		"changeset": "^0.2.6"
	},
	"devDependencies": {
		"@changesets/changelog-github": "^1.0.0",
		"@changesets/cli": "^3.0.3",
		"@eslint/js": "^9.16.0",
		"changeset": "^0.2.6",
		"eslint": "^9.36.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-react": "latest",
		"globals": "^15.13.0",
		"prettier": "^3.1.0",
		"prettier-plugin-svelte": "^3.2.4",
		"prettier-plugin-tailwindcss": "^0.6.5",
		"rimraf": "^3.0.2",
		"turbo": "^2.11.3",
		"typescript-eslint": "^8.16.0"
	},
	"packageManager": "pnpm@12.15.0",
	"engines": {
		"node": ">= 22"
	}
}
