chiffre d'affaires:
  unité: €
  produit:
    - TJM
    - nombre de jour
  avec:
    TJM:
      unité: €/jour
    nombre de jour:
      par défaut: 21 jour

auto-entrepreneur:
  par défaut: non

cotisations:
  public: oui
  valeur: taux * chiffre d'affaires
  avec:
    taux:
      variations:
        - si: auto-entrepreneur
          alors: 30%
        - sinon: 40%

charges:
  non applicable si: auto-entrepreneur
  par défaut:
    valeur: 10% * chiffre d'affaires
    plancher: 100€

revenu net:
  public: oui
  somme:
    - chiffre d'affaires
    - (- cotisations)
    - (- charges)

projections:
projections . quatre cinquième:
  public: oui
  titre: revenu net au 4/5e
  valeur: revenu net
  contexte:
    chiffre d'affaires . nombre de jour: chiffre d'affaires . nombre de jour * 4 / 5
