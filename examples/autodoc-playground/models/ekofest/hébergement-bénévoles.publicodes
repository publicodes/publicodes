# importer!:
#   depuis:
#     nom: "@incubateur-ademe/nosgestesclimat"
#   les règles:
#     - logement . vacances . empreinte hotel par nuit

hébergement . bénévoles:
  titre: Hébergement des bénévoles
  unité: kgCO2e
  valeur:
    variations:
      - si: type = 'camping'
        alors:
          nombre de nuits hôtel * nosgestesclimat . logement . vacances . empreinte
          hotel par nuit
      - si: type = 'hôtel'
        alors:
          nombre de nuits hôtel * nosgestesclimat . logement . vacances . empreinte
          hotel par nuit
      - sinon: 0

hébergement . bénévoles . type:
  titre: Hébergement des bénévoles
  type:
    une possibilité:
      - 'camping'
      - 'hôtel'
      - 'aucun'
  par défaut: 'aucun'
  meta:
    question: Prenez-vous en charge l'hébergement en hôtel des organisateurs et
      bénévoles du festival ?

hébergement . bénévoles . type . camping:
  titre: Oui, en camping
hébergement . bénévoles . type . hôtel:
  titre: Oui, en hôtel
hébergement . bénévoles . type . aucun:
  titre: Non

hébergement . bénévoles . nombre de nuits hôtel:
  unité: nuit
  valeur: informations . nombre de bénévoles * informations . nombre de nuits
