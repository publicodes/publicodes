# importer!:
#   depuis:
#     nom: "@incubateur-ademe/nosgestesclimat"
#   les règles:
#     - alimentation . petit déjeuner . tartine:
#         applicable si: oui
#     - alimentation . petit déjeuner . fruits:
#         applicable si: oui
#     - alimentation . petit déjeuner . yaourt:
#         applicable si: oui

alimentation . petits déjeuners:
  titre: Petits déjeuners
  applicable si: petits déjeuners présent
  note: On considère le petits déjeuner continental de Nos Gestes Climat
  valeur: nombre * continental

alimentation . petits déjeuners . continental:
  titre: Petit déjeuner continental
  unité: kgCO2e/repas
  valeur:
    somme:
      - nosgestesclimat . alimentation . petit déjeuner . tartine / 1 repas
      - nosgestesclimat . alimentation . petit déjeuner . fruits / 1 repas
      - nosgestesclimat . alimentation . petit déjeuner . yaourt  / 1 repas

alimentation . petits déjeuners présent:
  titre: Petits déjeuners sur l'événement
  par défaut: oui
  meta:
    question: Proposez-vous des petits déjeuners sur place ?

alimentation . petits déjeuners . nombre:
  valeur: nombre par jour * informations . nombre de jours

alimentation . petits déjeuners . nombre par jour:
  valeur: 1 repas * informations . nombre de personnes par jour
