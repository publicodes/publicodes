transport . artistes:
  titre: Transport des artistes
  unité: kgCO2e
  valeur:
    somme:
      - voiture
      - avion
      - train
      - tour bus

transport . artistes . voiture:
  applicable si: informations . nombre artistes en voiture > 0
  unité: kgCO2e
  valeur: informations . nombre artistes en train * distance * voiture . empreinte
    par km / voiture . remplissage moyen

transport . artistes . voiture . distance:
  titre: Distance moyenne parcourue par les artistes en voiture
  plancher: 0
  par défaut: 100
  unité: km
  meta:
    question: Quelle est la distance (A/R) parcourue en voiture en moyenne par les
      artistes pour venir au festival ?

transport . artistes . avion:
  applicable si: informations . nombre artistes en avion > 0
  unité: kgCO2e
  valeur: informations . nombre artistes en avion * distance * avion . empreinte par km

transport . artistes . avion . distance:
  titre: Distance moyenne parcourue par les artistes en avion
  plancher: 0
  par défaut: 1500
  unité: km
  meta:
    question: Quelle est la distance (A/R) parcourue en avion en moyenne par les
      artistes pour venir au festival ?

transport . artistes . train:
  applicable si: informations . nombre artistes en train > 0
  unité: kgCO2e
  valeur: informations . nombre artistes en train * distance * train . empreinte par km

transport . artistes . train . distance:
  titre: Distance moyenne parcourue par les artistes en train
  plancher: 0
  par défaut: 500
  unité: km
  meta:
    question: Quelle est la distance en moyenne (A/R) parcourue en train par les
      artistes pour venir au festival ?

transport . artistes . tour bus:
  applicable si: informations . nombre artistes en tour bus > 0
  unité: kgCO2e
  valeur: informations . nombre artistes en tour bus * distance * tour bus .
    empreinte par km

transport . artistes . tour bus . distance:
  titre: Distance moyenne parcourue par les artistes en tour bus
  plancher: 0
  par défaut: 1000
  unité: km
  meta:
    question: Quelle est la distance en moyenne (A/R) parcourue en tour bus par les
      artistes pour venir au festival ?
