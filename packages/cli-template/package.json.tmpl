{
	"name": "${NAME}-${PLATFORM}-${ARCH}",
	"version": "${VERSION}",
	"description": "${DESCRIPTION} (platform specific)",
	"type": "module",
	"os": [
		"${PLATFORM}"
	],
	"cpu": [
		"${ARCH}"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/publicodes/publicodes.git",
		"directory": "packages/cli-${PLATFORM}-${ARCH}"
	},
	"bin": {
		"publicodes2": "./bin/compiler"
	},
	"scripts": {
		"clean": "rm -rf bin",
		"build:compiler": "mkdir -p bin && install -m755 ../compiler/_build/default/bin/main.exe bin/compiler",
		"dev": "rolldown -c -w"
	},
	"files": [
		"bin"
	],
	"devDependencies": {
		"@types/bun": "^1",
		"bun": "^1.2.22"
	}
}
