{
	"name": "${NAME}-${PLATFORM}-${ARCH}",
	"version": "${VERSION}",
	"description": "${DESCRIPTION} (platform specific)",
	"type": "module",
	"os": [
		"${PLATFORM}"
	],
	"cpu": [
		"${ARCH}"
	],
	"bin": {
		"publicodes2": "./bin/publicodes.js"
	},
	"scripts": {
		"clean": "rm -rf bin",
		"build:compiler": "rolldown -c && install -m755 ../compiler/_build/default/bin/main.exe bin/compiler",
		"dev": "rolldown -c -w"
	},
	"files": [
		"bin"
	],
	"devDependencies": {
		"@types/bun": "^1",
		"bun": "^1.2.22",
		"rolldown": "1.0.0-beta.36"
	}
}
