module missing:
  importer: module missing

module empty:
  importer: ./module empty

package missing:
  valeur: rule vendored a + 3
  importer:
    paquet: package missing
    modèle: vendored a

vendored missing:
  valeur: rule vendored c + 3
  importer:
    paquet: package a
    modèle: vendored missing

key missing:
  valeur: rule vendored c + 3
  importer:
    paquet: package a
