simple error:
  public: oui
  valeur: ref
  contexte:
    ref: 4 euros
  avec:
    ref:
      public: oui
      valeur: oui

nested error:
  public: oui
  valeur:
    somme:
      - valeur: ref
        contexte:
          ref: 4 euros
      - valeur: ref
        contexte:
          ref: 2 euro
  avec:
    ref:
      public: oui
