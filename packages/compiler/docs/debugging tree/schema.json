{
  "$id": "https://publi.codes/debug.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Publicode Debugging Model",
  "type": "object",
  "required": [
    "rules"
  ],
  "properties": {
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "required": [
        "name",
        "_publicodes"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "the name of the rule"
        },
        "_publicodes": {
          "$ref": "#/$defs/_publicodes"
        }
      },
      "$ref": "#/$defs/evaluable"
    },
    "evaluable": {
      "required": [
        "value mecanism",
        "chainable mecanisms"
      ],
      "properties": {
        "value mecanism": {
          "$ref": "#/$defs/value_mecanism"
        },
        "chainable mecanisms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/chain_mecanism"
          }
        }
      }
    },
    "_publicodes": {
      "type": "object",
      "required": [
        "id",
        "position"
      ],
      "properties": {
        "id": {
          "type": "string",
          "descriptions": "the value identifier"
        },
        "position": {
          "type": "object",
          "descriptions": "the node position",
          "required": [
            "file",
            "start",
            "end"
          ],
          "properties": {
            "file": {
              "type": "string"
            },
            "start": {
              "$ref": "#/$defs/position"
            },
            "end": {
              "$ref": "#/$defs/position"
            }
          }
        }
      }
    },
    "position": {
      "type": "object",
      "required": [
        "index",
        "line",
        "column"
      ],
      "properties": {
        "index": {
          "type": "integer"
        },
        "line": {
          "type": "integer"
        },
        "column": {
          "type": "integer"
        }
      }
    },
    "value_mecanism": {
      "type": "object",
      "required": [
        "type",
        "_publicodes"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "_publicodes": {
          "$ref": "#/$defs/_publicodes"
        }
      },
      "anyOf": [
        {
          "$ref": "#/$defs/mecanisms/expr"
        },
        {
          "$ref": "#/$defs/mecanisms/value"
        },
        {
          "$ref": "#/$defs/mecanisms/is_applicable"
        },
        {
          "$ref": "#/$defs/mecanisms/is_not_applicable"
        },
        {
          "$ref": "#/$defs/mecanisms/sum"
        },
        {
          "$ref": "#/$defs/mecanisms/product"
        },
        {
          "$ref": "#/$defs/mecanisms/all_of"
        },
        {
          "$ref": "#/$defs/mecanisms/min_of"
        },
        {
          "$ref": "#/$defs/mecanisms/max_of"
        },
        {
          "$ref": "#/$defs/mecanisms/one_of"
        },
        {
          "$ref": "#/$defs/mecanisms/not_defined"
        },
        {
          "$ref": "#/$defs/mecanisms/variations"
        }
      ]
    },
    "chain_mecanism": {
      "type": "object",
      "required": [
        "type",
        "_publicodes"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "_publicodes": {
          "$ref": "#/$defs/_publicodes"
        }
      },
      "anyOf": [
        {
          "$ref": "#/$defs/mecanisms/context"
        },
        {
          "$ref": "#/$defs/mecanisms/applicable_if"
        },
        {
          "$ref": "#/$defs/mecanisms/not_applicable_if"
        },
        {
          "$ref": "#/$defs/mecanisms/_type"
        },
        {
          "$ref": "#/$defs/mecanisms/default"
        },
        {
          "$ref": "#/$defs/mecanisms/ceiling"
        },
        {
          "$ref": "#/$defs/mecanisms/floor"
        },
        {
          "$ref": "#/$defs/mecanisms/round_up"
        },
        {
          "$ref": "#/$defs/mecanisms/round_down"
        },
        {
          "$ref": "#/$defs/mecanisms/round_nearest"
        }
      ]
    },
    "mecanisms": {
      "expr": {
        "required": [
          "parameters"
        ],
        "properties": {
          "type": {
            "const": "expr"
          },
          "parameters": {
            "$ref": "#/$defs/expression"
          }
        }
      },
      "value": {
        "required": [
          "parameters"
        ],
        "properties": {
          "type": {
            "const": "value"
          },
          "parameters": {
            "type": "object",
            "$ref": "#/$defs/evaluable"
          }
        }
      },
      "is_applicable": {
        "required": [
          "parameters"
        ],
        "properties": {
          "type": {
            "const": "is_applicable"
          },
          "parameters": {
            "$ref": "#/$defs/evaluable"
          }
        }
      },
      "is_not_applicable": {
        "required": [
          "parameters"
        ],
        "properties": {
          "type": {
            "const": "is_applicable"
          },
          "parameters": {
            "$ref": "#/$defs/evaluable"
          }
        }
      },
      "sum": {
        "required": [
          "parameters"
        ],
        "properties": {
          "type": {
            "const": "sum"
          },
          "parameters": {
            "type": "array",
            "items": {
              "type": "object",
              "$ref": "#/$defs/evaluable"
            }
          }
        }
      },
      "product": {
        "required": [
          "parameters"
        ],
        "properties": {
          "type": {
            "const": "product"
          },
          "parameters": {
            "type": "array",
            "items": {
              "type": "object",
              "$ref": "#/$defs/evaluable"
            }
          }
        }
      },
      "all_of": {
        "required": [
          "parameters"
        ],
        "properties": {
          "type": {
            "const": "all_of"
          },
          "parameters": {
            "type": "array",
            "items": {
              "type": "object",
              "$ref": "#/$defs/evaluable"
            }
          }
        }
      },
      "min_of": {
        "required": [
          "parameters"
        ],
        "properties": {
          "type": {
            "const": "min_of"
          },
          "parameters": {
            "type": "array",
            "items": {
              "type": "object",
              "$ref": "#/$defs/evaluable"
            }
          }
        }
      },
      "max_of": {
        "required": [
          "parameters"
        ],
        "properties": {
          "type": {
            "const": "max_of"
          },
          "parameters": {
            "type": "array",
            "items": {
              "type": "object",
              "$ref": "#/$defs/evaluable"
            }
          }
        }
      },
      "one_of": {
        "required": [
          "parameters"
        ],
        "properties": {
          "type": {
            "const": "one_of"
          },
          "parameters": {
            "type": "array",
            "items": {
              "type": "object",
              "$ref": "#/$defs/evaluable"
            }
          }
        }
      },
      "not_defined": {
        "properties": {
          "type": {
            "const": "not_defined"
          }
        }
      },
      "variations": {
        "required": [
          "parameters"
        ],
        "properties": {
          "type": {
            "const": "variations"
          },
          "parameters": {
            "type": "object",
            "required": [
              "conditions"
            ],
            "properties": {
              "conditions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "if",
                    "then"
                  ],
                  "properties": {
                    "if": {
                      "$ref": "#/$defs/evaluable"
                    },
                    "then": {
                      "$ref": "#/$defs/evaluable"
                    }
                  }
                }
              },
              "else": {
                "$ref": "#/$defs/evaluable"
              }
            }
          }
        }
      },
      "context": {
        "required": [
          "parameters"
        ],
        "properties": {
          "type": {
            "const": "context"
          },
          "parameters": {
            "type": "object",
            "patternProperties": {
              ".": {
                "$ref": "#/$defs/evaluable"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "applicable_if": {
        "required": [
          "type",
          "parameters"
        ],
        "properties": {
          "type": {
            "const": "applicable_if"
          },
          "parameters": {
            "$ref": "#/$defs/evaluable"
          }
        }
      },
      "not_applicable_if": {
        "required": [
          "type",
          "parameters"
        ],
        "properties": {
          "type": {
            "const": "not_applicable_if"
          },
          "parameters": {
            "$ref": "#/$defs/evaluable"
          }
        }
      },
      "_type": {
        "required": [
          "type",
          "parameters"
        ],
        "properties": {
          "type": {
            "const": "type"
          }
        },
        "anyOf": [
          {
            "properties": {
              "parameters": {
                "type": "object",
                "properties": {
                  "type": {
                    "const": "texte"
                  }
                }
              }
            }
          },
          {
            "properties": {
              "parameters": {
                "type": "object",
                "properties": {
                  "type": {
                    "const": "boolean"
                  }
                }
              }
            }
          },
          {
            "properties": {
              "parameters": {
                "type": "object",
                "properties": {
                  "type": {
                    "const": "date"
                  }
                }
              }
            }
          },
          {
            "properties": {
              "parameters": {
                "type": "object",
                "properties": {
                  "type": {
                    "const": "number"
                  }
                }
              }
            }
          }
        ]
      },
      "default": {
        "properties": {
          "type": {
            "const": "default"
          },
          "parameters": {
            "$ref": "#/$defs/evaluable"
          }
        }
      },
      "ceiling": {
        "properties": {
          "type": {
            "const": "ceiling"
          },
          "parameters": {
            "$ref": "#/$defs/evaluable"
          }
        }
      },
      "floor": {
        "properties": {
          "type": {
            "const": "floor"
          },
          "parameters": {
            "$ref": "#/$defs/evaluable"
          }
        }
      },
      "round_up": {
        "properties": {
          "type": {
            "const": "round up"
          },
          "parameters": {
            "$ref": "#/$defs/evaluable"
          }
        }
      },
      "round_down": {
        "properties": {
          "type": {
            "const": "round down"
          },
          "parameters": {
            "$ref": "#/$defs/evaluable"
          }
        }
      },
      "round_nearest": {
        "properties": {
          "type": {
            "const": "round nearest"
          },
          "parameters": {
            "$ref": "#/$defs/evaluable"
          }
        }
      }
    },
    "expression": {
      "anyOf": [
        {
          "$ref": "#/$defs/expressions/constant"
        },
        {
          "$ref": "#/$defs/expressions/ref"
        },
        {
          "$ref": "#/$defs/expressions/binary"
        },
        {
          "$ref": "#/$defs/expressions/unary"
        }
      ]
    },
    "expressions": {
      "constant": {
        "properties": {
          "type": {
            "const": "constant"
          },
          "parameters": {
            "anyOf": [
              {
                "properties": {
                  "type": {
                    "const": "number"
                  },
                  "parameters": {
                    "type": "object",
                    "required": [
                      "value"
                    ],
                    "properties": {
                      "value": {
                        "type": "number"
                      },
                      "unit": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "ref": {
        "required": [
          "type",
          "parameters"
        ],
        "properties": {
          "type": {
            "const": "ref"
          },
          "parameters": {
            "type": "string"
          }
        }
      },
      "binary": {
        "required": [
          "type",
          "parameters"
        ],
        "properties": {
          "type": {
            "anyOf": [
              {
                "const": "add"
              },
              {
                "const": "sub"
              },
              {
                "const": "mul"
              },
              {
                "const": "div"
              },
              {
                "const": "pow"
              },
              {
                "const": "gt"
              },
              {
                "const": "lt"
              },
              {
                "const": "gteq"
              },
              {
                "const": "lteq"
              },
              {
                "const": "eq"
              },
              {
                "const": "noteq"
              },
              {
                "const": "and"
              },
              {
                "const": "or"
              },
              {
                "const": "max"
              },
              {
                "const": "min"
              }
            ]
          },
          "parameters": {
            "type": "object",
            "required": [
              "left",
              "right"
            ],
            "properties": {
              "left": {
                "$ref": "#/$defs/expression"
              },
              "right": {
                "$ref": "#/$defs/expression"
              }
            }
          }
        }
      },
      "unary": {
        "required": [
          "type",
          "parameters"
        ],
        "properties": {
          "type": {
            "anyOf": [
              {
                "const": "neg"
              }
            ]
          },
          "parameters": {
            "$ref": "#/$defs/expression"
          }
        }
      }
    }
  }
}
